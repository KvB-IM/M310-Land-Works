# ---------------------------------------------------------------------------
# M310 Land Works — environment variables
#
# Set these in Vercel: Project → Settings → Environment Variables
# (Production + Preview). For local `vercel dev`, run `vercel env pull`.
# ---------------------------------------------------------------------------

# --- Email (Resend HTTP API) -----------------------------------------------
# https://resend.com/api-keys — create a key with "Sending access".
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where new leads land. Comma-separate for multiple recipients.
LEAD_TO_EMAIL=quote@m310landworks.com,yashwanth.challa@insurancemasters.biz,mario@insurancemasters.biz

# Must be on a domain verified in Resend, or delivery will be rejected.
LEAD_FROM_EMAIL=M310 Land Works <leads@m310landworks.com>

# Optional silent copy (e.g. a CRM drop address).
LEAD_BCC_EMAIL=

# Send the property owner a "we got it" confirmation. "true" to enable.
LEAD_AUTOREPLY=false

# --- Storage (Vercel Blob) --------------------------------------------------
# Created for you when you connect a Blob store to the project. On Vercel the
# SDK prefers the auto-rotating OIDC credentials, so you normally do not need
# to set anything here by hand.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx
# BLOB_STORE_ID=store_xxxxxxxx

# Must match how the store was created: "private" (recommended — leads are PII)
# or "public". Defaults to private.
BLOB_ACCESS=private

# --- Reading leads back (GET /api/leads) ------------------------------------
# Long random string. Leave unset to disable the export endpoint entirely.
# Generate one with:  node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
LEADS_ADMIN_KEY=

# --- Anti-abuse -------------------------------------------------------------
# Extra hostnames allowed to POST the form, beyond the deploy's own host and
# *.vercel.app. Comma-separated, no scheme. Usually only needed for staging.
ALLOWED_ORIGIN_HOSTS=
